# RESTScope parser-only configuration
# Copy this file to .env and adjust values as needed.

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Optional parser workspace root for logs and generated local data.
# DATA_DIR=./data

# Optional explicit log file path. Defaults to {DATA_DIR}/logs/restscope.log.
# LOG_FILE=./data/logs/restscope.log

# Strong model for reasoning-heavy tasks.
THINK_MODEL=glm-4.5-air
THINK_API_KEY=your-api-key
THINK_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# THINK_TIMEOUT=120
# THINK_TEMPERATURE=0.7
# THINK_MAX_TOKENS=128000

# Fast model for lightweight tasks.
# FAST_API_KEY and FAST_BASE_URL default to THINK_API_KEY and THINK_BASE_URL.
FAST_MODEL=glm-4.7-flash
# FAST_API_KEY=your-api-key
# FAST_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# FAST_TIMEOUT=60
# FAST_TEMPERATURE=0.7
# FAST_MAX_TOKENS=128000
