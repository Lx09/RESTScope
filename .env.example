# Copy to .env. Model metadata belongs in models.toml; this file keeps only
# App settings and secrets. Omit MODELS_FILE for parser-only use.
MODELS_FILE=./models.toml
DEEPSEEK_API_KEY=your-key

LOG_LEVEL=INFO
# LIB_LOG_LEVEL=WARNING
# DATA_DIR=./data
# LOG_FILE=./data/logs/restscope.log

DB_URL=sqlite:///./data/restscope.db
# DB_SQL_LOG=false
# DB_POOL_SIZE=5
# DB_POOL_EXTRA=10

# MCP_FILE=./mcp.servers.json
# RUN_SEED=731

UI_ON=false
UI_PORT=8765

# Optional local Arize Phoenix tracing. Install with: uv sync --extra tracing
TRACE_ON=false
TRACE_URL=http://localhost:6006
TRACE_PROJECT=restscope
TRACE_API_KEY=
TRACE_PROTOCOL=http/protobuf
TRACE_BATCH=true
TRACE_MAX_BYTES=65536
TRACE_FLUSH_TIMEOUT=5
